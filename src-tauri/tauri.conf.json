{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Derot My Brain",
    "version": "0.9.1",
    "identifier": "com.derotmybrain.desktop",
    "build": {
        "beforeDevCommand": "",
        "devUrl": "http://127.0.0.1:45123",
        "beforeBuildCommand": "",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Derot My Brain",
                "width": 1280,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "center": true,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:45123; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:",
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "publisher": "SamGVanN",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "../published-backend"
        ]
    }
}